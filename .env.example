# Modelo gerador no Ollama Cloud
LLM_OLLAMA_HOST=https://ollama.com
LLM_OLLAMA_API_KEY=substitua_por_sua_chave
LLM_MODEL=gpt-oss:120b

# Embeddings locais na VPS
EMBED_OLLAMA_HOST=http://127.0.0.1:11434
EMBED_MODEL=bge-m3

# Dados persistentes e limites de memória para ingestão
CHROMA_DIR=/opt/chatboat-ppg/data/chroma
INGEST_BATCH_SIZE=1
AUTO_INGEST=true

# Nunca habilitar em acesso público
ENABLE_ADMIN_ENDPOINTS=false
